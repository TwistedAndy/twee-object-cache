{
	"name": "twistedandy/twee-cache",
	"description": "Twee Cache",
	"license": "MIT",
	"type": "wordpress-plugin",
	"config": {
		"audit": {
			"block-insecure": false
		},
		"allow-plugins": {}
	},
	"require-dev": {
		"phpunit/phpunit": "^12"
	},
	"scripts": {
		"test": "@php vendor/phpunit/phpunit/phpunit --no-coverage",
		"test:redis": "set TW_CACHE_ENGINE=redis && composer test",
		"test:memcached": "set TW_CACHE_ENGINE=memcached && composer test",
		"test:apcu": "set TW_CACHE_ENGINE=apcu && composer test",
		"zip": "@php bin/release.php zip",
		"release": "@php bin/release.php publish"
	},
	"scripts-descriptions": {
		"zip": "Builds build/twee-cache-{version}.zip from the plugin directory, with the uncommitted changes.",
		"release": "Publishes the ZIP as GitHub release v{version} with its section of CHANGELOG.md as the notes."
	}
}
