{
	"name": "twistedandy/twee-object-cache",
	"description": "Twee Object Cache",
	"license": "MIT",
	"type": "wordpress-plugin",
	"config": {
		"audit": {
			"block-insecure": false
		},
		"allow-plugins": {}
	},
	"require-dev": {
		"phpunit/phpunit": "^12"
	},
	"scripts": {
		"test": "@php vendor/phpunit/phpunit/phpunit --no-coverage",
		"test:redis": "set TW_CACHE_ENGINE=redis && composer test",
		"test:memcached": "set TW_CACHE_ENGINE=memcached && composer test",
		"test:apcu": "set TW_CACHE_ENGINE=apcu && composer test"
	}
}
